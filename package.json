{
  "name": "adopcion-api",
  "version": "1.0.0",
  "description": "Backend API para plataforma de adopción de animales",
  "main": "src/app.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "build": "npx prisma generate && npx prisma db push",
    "postinstall": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:seed": "node prisma/seed.js",
    "set-super-admin": "node prisma/set-super-admin.js",
    "db:studio": "npx prisma studio",
    "test": "jest",
    "test:unit": "jest --testMatch='**/tests/unit/**/*.test.js'",
    "test:coverage": "jest --coverage",
    "test:security": "node tests/security/security_audit.js",
    "test:load": "k6 run tests/performance/load_test.js",
    "test:load:browsing": "k6 run --env SCENARIO=browsing tests/performance/load_test.js",
    "test:load:submission": "k6 run --env SCENARIO=submission tests/performance/load_test.js",
    "test:load:stress": "k6 run --env SCENARIO=stress tests/performance/load_test.js",
    "test:load:spike": "k6 run --env SCENARIO=spike tests/performance/load_test.js"
  },
  "keywords": [
    "adopcion",
    "animales",
    "api",
    "express"
  ],
  "author": "Facundo Cornejo",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.11",
    "prisma": "^5.22.0",
    "resend": "^6.9.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "axios": "^1.13.5",
    "jest": "^30.2.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.2.2"
  }
}
